{
  "name": "erp-inventory-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "进销存系统 MCP Server（stdio / http 双传输）：把库存、单据、报表、主数据、自然语言指令与运行状态暴露给 AI Agent",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "erp-inventory-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node scripts/start-http.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:http": "node scripts/smoke-http.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
