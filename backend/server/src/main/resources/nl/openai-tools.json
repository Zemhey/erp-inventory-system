[
  {
    "type": "function",
    "function": {
      "name": "help",
      "description": "返回系统支持的自然语言操作意图与示例。用户询问“能做什么/帮助”时使用。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "query_inventory",
      "description": "查询库存余额（实存/预占/可用）。可按 SKU、仓库、批次过滤；全部省略则返回所有库存行。",
      "parameters": {
        "type": "object",
        "properties": {
          "skuId": { "type": "integer", "description": "SKU id" },
          "warehouseId": { "type": "integer", "description": "仓库 id" },
          "batchNo": { "type": "string", "description": "批次号" },
          "onlyAvailable": { "type": "boolean", "description": "只看可用量大于 0 的行" }
        },
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_documents",
      "description": "分页查询进货单 / 出货单 / 退货单列表，可按状态、往来单位过滤。",
      "parameters": {
        "type": "object",
        "properties": {
          "docType": { "type": "string", "enum": ["PURCHASE", "SALES", "RETURN"] },
          "status": {
            "type": "string",
            "enum": ["DRAFT", "SUBMITTED", "APPROVED", "PARTIAL", "COMPLETED", "VOIDED", "REJECTED"]
          },
          "partyId": { "type": "integer", "description": "进货=供应商 id；出货/退货=客户 id" },
          "originSalesOrderId": { "type": "integer", "description": "退货单的原出货单 id" },
          "page": { "type": "integer", "minimum": 1 },
          "size": { "type": "integer", "minimum": 1, "maximum": 200 }
        },
        "required": ["docType"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_document",
      "description": "按 id 查询一张进货单 / 出货单 / 退货单的详情。",
      "parameters": {
        "type": "object",
        "properties": {
          "docType": { "type": "string", "enum": ["PURCHASE", "SALES", "RETURN"] },
          "id": { "type": "integer", "description": "单据 id" }
        },
        "required": ["docType", "id"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "inventory_summary",
      "description": "查询进销存汇总（期初 + 入 − 出 = 期末）。账期格式 yyyy-MM，省略时默认当前月。",
      "parameters": {
        "type": "object",
        "properties": {
          "period": { "type": "string", "pattern": "^\\d{4}-\\d{2}$", "description": "账期，如 2026-10" },
          "warehouseId": { "type": "integer", "description": "可选仓库过滤" }
        },
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "query_master_data",
      "description": "查询主数据：商品 / SKU / 供应商 / 客户 / 仓库。",
      "parameters": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["PRODUCT", "SKU", "SUPPLIER", "CUSTOMER", "WAREHOUSE"] },
          "keyword": { "type": "string", "description": "编码/名称模糊匹配" },
          "productId": { "type": "integer", "description": "按商品过滤 SKU" },
          "color": { "type": "string", "description": "按颜色过滤 SKU" },
          "skuSize": { "type": "string", "description": "按尺码过滤 SKU" },
          "onlyEnabled": { "type": "boolean", "description": "仓库：仅启用" },
          "page": { "type": "integer", "minimum": 1 },
          "size": { "type": "integer", "minimum": 1, "maximum": 200 }
        },
        "required": ["type"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "create_purchase_order",
      "description": "创建一张进货单草稿。金额由后端按数量×单价计算；单价单位是分。",
      "parameters": {
        "type": "object",
        "properties": {
          "supplierId": { "type": "integer" },
          "warehouseId": { "type": "integer" },
          "bizDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "remark": { "type": "string" },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "skuId": { "type": "integer" },
                "qty": { "type": "integer", "minimum": 1 },
                "unitPriceAmount": { "type": "integer", "minimum": 0, "description": "单价（分）" }
              },
              "required": ["skuId", "qty", "unitPriceAmount"],
              "additionalProperties": false
            }
          }
        },
        "required": ["supplierId", "warehouseId", "lines"],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "create_sales_order",
      "description": "创建一张出货单草稿（建单即预占库存）。金额由后端按数量×单价×折扣计算；单价单位是分。",
      "parameters": {
        "type": "object",
        "properties": {
          "customerId": { "type": "integer" },
          "warehouseId": { "type": "integer" },
          "bizDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "remark": { "type": "string" },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "skuId": { "type": "integer" },
                "qty": { "type": "integer", "minimum": 1 },
                "unitPriceAmount": { "type": "integer", "minimum": 0, "description": "单价（分）" },
                "discountRate": { "type": "integer", "minimum": 1, "maximum": 10000, "description": "万分比，10000=不打折" }
              },
              "required": ["skuId", "qty", "unitPriceAmount"],
              "additionalProperties": false
            }
          }
        },
        "required": ["customerId", "warehouseId", "lines"],
        "additionalProperties": false
      }
    }
  }
]
