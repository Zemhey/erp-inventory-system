# ════════════════════════════════════════════════════════════════════════════
# 生产环境变量模板
#
# 用法：
#   cp infra/deploy/.env.example infra/deploy/.env
#   然后**必须**修改 POSTGRES_PASSWORD 与 ERP_JWT_SECRET
#
# .env 已被 .gitignore 忽略；不要把真实值写进本文件或提交到 Git。
# ════════════════════════════════════════════════════════════════════════════

# ── 数据库（必填） ─────────────────────────────────────────────────────────
# 生成强密码：openssl rand -base64 32
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-strong-password

# ── JWT（必填，≥ 32 字节） ─────────────────────────────────────────────────
# 生成：openssl rand -base64 48
# 更换密钥会让所有已签发 token 立即失效（用户需重新登录），这是预期行为。
ERP_JWT_SECRET=change-me-at-least-32-bytes-random-secret

# ── 端口与绑定 ─────────────────────────────────────────────────────────────
# 本地/未备案：WEB_BIND_IP=0.0.0.0，浏览器访问 http://<IP>:18080
# 备案后接宿主 nginx 做 HTTPS：WEB_BIND_IP=127.0.0.1，只让本机 nginx 访问
WEB_BIND_IP=0.0.0.0
WEB_PORT=18080
# PostgreSQL 只绑 127.0.0.1；此端口仅用于本机排障/备份
PG_HOST_PORT=15435

# ── 运行参数（可选） ───────────────────────────────────────────────────────
TZ=Asia/Shanghai
# 部署脚本每次会覆盖成 <git短SHA>-<时间>；手工 compose 时可留 latest
IMAGE_TAG=latest
BACKUP_RETENTION_DAYS=14

# JVM 参数（默认值见 docker-compose.prod.yml；一般不用改）
# JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8"

# 日志级别（默认 INFO；排障时临时把 com.erp 调成 DEBUG）
# LOG_LEVEL_ROOT=INFO
# LOG_LEVEL_ERP=INFO

# 镜像仓库不可达时替换基础镜像（国内镜像/内网 Harbor）
# BACKEND_BUILD_IMAGE=eclipse-temurin:17-jdk-alpine
# BACKEND_RUNTIME_IMAGE=eclipse-temurin:17-jre-alpine
# WEB_BUILD_IMAGE=node:22-alpine
# WEB_RUNTIME_IMAGE=nginx:1.27-alpine
