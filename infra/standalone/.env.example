# ============================================================================
# 单机版环境变量模板
#
# 推荐直接用 start-standalone 启动：它在 .env 不存在时会自动生成随机密钥。
# 本文件只用于手工排查/覆盖；不要提交真实 .env。
#
# 手工复制后必须修改 POSTGRES_PASSWORD 与 ERP_JWT_SECRET；
# 启动脚本拒绝占位值。
# ============================================================================

POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-strong-password
ERP_JWT_SECRET=change-me-at-least-32-bytes-random-secret

# 单机版默认只监听回环，避免无意暴露到局域网。
# 需要局域网访问时改成 0.0.0.0，并自行确认系统防火墙。
WEB_BIND_IP=127.0.0.1
WEB_PORT=18090
# PostgreSQL 只给本机排障/备份用，不要改成 0.0.0.0
PG_HOST_PORT=15439

TZ=Asia/Shanghai
# 镜像 tag：默认 standalone。用 M6 离线垫片时通常是 standalone-local。
IMAGE_TAG=standalone
BACKUP_RETENTION_DAYS=14

# 可选：基础镜像替换（内网仓库/国内镜像）
# BACKEND_BUILD_IMAGE=eclipse-temurin:17-jdk-alpine
# BACKEND_RUNTIME_IMAGE=eclipse-temurin:17-jre-alpine
# WEB_BUILD_IMAGE=node:22-alpine
# WEB_RUNTIME_IMAGE=nginx:1.27-alpine
# NPM_REGISTRY=https://registry.npmmirror.com
