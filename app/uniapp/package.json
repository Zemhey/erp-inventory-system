{
  "name": "erp-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "进销存系统移动端（uni-app：微信小程序 / Android / H5）",
  "scripts": {
    "dev:h5": "uni",
    "build:h5": "uni build",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "dev:app": "uni -p app",
    "build:app": "uni build -p app",
    "preflight": "node scripts/preflight.mjs all",
    "preflight:mp-weixin": "node scripts/preflight.mjs mp-weixin",
    "preflight:app": "node scripts/preflight.mjs app --verbose",
    "preflight:h5": "node scripts/preflight.mjs h5",
    "prebuild:h5": "node scripts/preflight.mjs h5",
    "prebuild:mp-weixin": "node scripts/preflight.mjs mp-weixin",
    "prebuild:app": "node scripts/preflight.mjs app",
    "build:mp-weixin:force": "node scripts/preflight.mjs mp-weixin --warn-only --allow-http && uni build -p mp-weixin",
    "build:app:force": "node scripts/preflight.mjs app --warn-only --allow-http && uni build -p app",
    "set:appid": "node scripts/set-appid.mjs",
    "make:icons": "node scripts/make-icons.mjs",
    "type-check": "vue-tsc --noEmit",
    "pree2e": "node e2e/start-db.mjs",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:db:stop": "node e2e/stop-db.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-plus": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/uni-stacktracey": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.5",
    "@vue/runtime-core": "^3.4.21",
    "typescript": "^5.4.5",
    "vite": "5.2.8",
    "vue-tsc": "^2.0.29"
  }
}
