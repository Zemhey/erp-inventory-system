# 复制成 keystore.properties（同目录，已被 .gitignore 忽略）后填真实值；口令取自仓库外的私有文件，不进仓库。
# 证书与别名：D:\MajorCacheFolder\erp-keystore\yunshang-erp.jks / yunshang-erp（自签，有效期到 2054-03-16）
# 注意：Java properties 会把单个反斜杠当转义，路径请写成正斜杠（D:/...）或双反斜杠。
storeFile=D:/MajorCacheFolder/erp-keystore/yunshang-erp.jks
storePassword=
keyAlias=yunshang-erp
keyPassword=
