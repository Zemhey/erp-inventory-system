<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      NoActionBar：0.2.0 用的是 Theme.Material.Light，系统会给一条 colorPrimary 的深蓝色标题栏，
      再叠上 H5 自己的导航条，用户看到的就是"上面一块蓝的挡着"。这里整条去掉，顶栏只留界面自己的。
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/shell_status_bar</item>
        <item name="android:colorAccent">@color/shell_accent</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/shell_status_bar</item>
        <item name="android:navigationBarColor">@color/shell_nav_bar</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
