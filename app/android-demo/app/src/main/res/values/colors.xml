<?xml version="1.0" encoding="utf-8"?>
<!-- 壳层配色：浅色模式取值，夜间模式由 values-night 同名资源覆盖 -->
<resources>
    <!-- 启动/错误页与 WebView 底色，避免白底闪烁 -->
    <color name="shell_bg">#F5F6F8</color>
    <!-- 错误页文字色 -->
    <color name="shell_text">#1F2937</color>
    <!-- 状态栏/导航栏在深浅两套里都取深色，这样始终配浅色图标，无需切换 LIGHT 标记 -->
    <color name="shell_status_bar">#14283F</color>
    <color name="shell_nav_bar">#14283F</color>
    <!-- 窗口底色，给 Activity 启动到 WebView 绘制之间的空隙垫底色 -->
    <color name="shell_window_bg">#F5F6F8</color>
</resources>
